{
  "name": "fructy",
  "version": "12.0.0",
  "private": true,
  "description": "Fructy V12 — plateforme de formation, produits numériques et portefeuille",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env backend/database/migrate.js",
    "test": "node --test tests/*.test.js",
    "admin:bootstrap": "node --env-file-if-exists=.env backend/bootstrap-admin.js"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "dependencies": {
    "pg": "8.13.1",
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0"
  }
}
