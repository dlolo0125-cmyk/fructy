# Copiez ce fichier vers .env puis renseignez vos valeurs. Ne publiez jamais .env.
# Premier administrateur (créé au premier démarrage sur une base vide)
ADMIN_PHONE=
ADMIN_PASSWORD=
# Optionnel : clé de signature des sessions (sinon data/secret.key est généré)
SECRET=
# Dépôt SasPay (Togo)
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_NETWORK_TMONEY=tmoney_tg
SASPAY_NETWORK_FLOOZ=moov_tg
APP_BASE_URL=
# Dépôt Chariow (facultatif)
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
