# Copiez ce fichier vers .env puis renseignez vos valeurs. Ne publiez jamais .env.
# Base PostgreSQL (Neon) : Connect > Connection string. Elle contient un mot de passe.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Premier administrateur (créé au premier démarrage si absent)
ADMIN_PHONE=
ADMIN_PASSWORD=
# Clé de signature des sessions (conseillé : 32+ caractères aléatoires ; sinon générée et conservée en base)
SECRET=
# Dépôt SasPay (Togo)
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_NETWORK_TMONEY=tmoney_tg
SASPAY_NETWORK_FLOOZ=moov_tg
APP_BASE_URL=
# Dépôt Chariow (facultatif)
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
